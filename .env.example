# Snowflake (set the same keys in Render → Environment)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# Optional: Vercel URL(s), comma-separated — tightens CORS (recommended for production)
# FRONTEND_URL=https://your-app.vercel.app

# Render sets PORT automatically; local dev defaults to 5000
# PORT=5000
